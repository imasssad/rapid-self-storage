# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# --- Storage (Vercel Blob, private store) ---
# Added automatically when you connect the Blob store to the project (Vercel → Storage): either this token, or
# (newer Vercel) BLOB_STORE_ID used with Vercel OIDC. Either works. Leave both unset locally to use .data/ instead.
BLOB_READ_WRITE_TOKEN=

# --- Admin panel ---
# Random string, 32+ characters. Signs the login cookie. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First owner login only. On the first sign-in the owner account is created from these;
# after that they're ignored. Delete ADMIN_PASSWORD from Vercel once the owner has signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Contact form email (optional) ---
# Without these, the form tells visitors to call the office. Get a key at https://resend.com
# and verify the sending domain there. Recipients set in the admin panel (Settings) take priority
# over CONTACT_TO_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=office@rapidselfstorage.com
CONTACT_FROM_EMAIL=Rapid Self Storage <website@rapidselfstorage.com>
